{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "automerge": true,
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "simplecov 1.3.0 and later require Ruby 3.3; keep versions for Ruby 3.2 (the oldest Ruby in CI) until it is dropped",
      "matchManagers": [
        "bundler"
      ],
      "matchPackageNames": [
        "simplecov"
      ],
      "allowedVersions": "<1.3.0"
    },
    {
      "description": "parallel (a rubocop dependency) 2.3.0 and later require Ruby 3.3; keep versions for Ruby 3.2 (the oldest Ruby in CI) until it is dropped",
      "matchManagers": [
        "bundler"
      ],
      "matchPackageNames": [
        "parallel"
      ],
      "allowedVersions": "<2.3.0"
    }
  ]
}
