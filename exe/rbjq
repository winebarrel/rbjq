#!/usr/bin/env ruby
# frozen_string_literal: true

# jq programs can recurse deeply; the evaluator uses the Ruby stack, so run it
# in a thread with a large stack. Thread stack sizes are read from the
# environment at interpreter start-up, hence the one-time re-exec.
STACK_SIZE = (1024 * 1024 * 1024).to_s
unless ENV['RBJQ_STACK_CONFIGURED']
  ENV['RBJQ_STACK_CONFIGURED'] = '1'
  ENV['RUBY_THREAD_VM_STACK_SIZE'] ||= STACK_SIZE
  ENV['RUBY_THREAD_MACHINE_STACK_SIZE'] ||= STACK_SIZE
  begin
    require 'rbconfig'
    exec(RbConfig.ruby, __FILE__, *ARGV)
  rescue SystemCallError
    # fall through and run with the default stack
  end
end

$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))
require 'rbjq/cli'

Thread.report_on_exception = false
status = Thread.new { Rbjq::CLI.start(ARGV) }.value
exit status
